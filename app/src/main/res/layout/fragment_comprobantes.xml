<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card: Explicación Mecanismo 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="#9C27B0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✍️ Mecanismo 2: Firma Digital Asimétrica (Ed25519)"
                    android:textColor="#4A148C"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="La clínica firma recetas con su clave privada Ed25519. Cualquier persona con la clave pública puede verificar que el documento no ha sido alterado (Integridad y Autenticidad)."
                    android:textColor="#37474F"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Selección ID para Receta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ID del Expediente">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etComprobanteRecordId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmitirComprobante"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:backgroundTint="#7B1FA2"
                android:text="Emitir Receta Firmada" />
        </LinearLayout>

        <!-- Detalle Receta Emitida -->
        <TextView
            android:id="@+id/tvDetalleComprobante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#F3E5F5"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="Genera un comprobante para ver la firma..."
            android:textColor="#4A148C"
            android:textSize="12sp" />

        <!-- Verificación Original -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificarOriginal"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E7D32"
            android:text="1. Verificar Firma Digital Original"
            app:icon="@android:drawable/checkbox_on_background" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#CCCCCC" />

        <!-- Prueba de Manipulación / Ataque -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ Demostración de Integridad (Simulación de Ataque)"
            android:textColor="#C62828"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Edita el JSON del comprobante abajo (ej. cambia el nombre o diagnóstico) y pulsa 'Verificar Firma Manipulada':"
            android:textColor="#555555"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="JSON editable del Comprobante">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etJsonEditable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:lines="4"
                android:textSize="11sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerificarManipulado"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#D32F2F"
            android:text="2. Verificar Firma Manipulada"
            app:icon="@android:drawable/ic_delete" />

        <!-- Resultado de la Verificación -->
        <TextView
            android:id="@+id/tvResultadoVerificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#EEEEEE"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:text="Estado de verificación: Esperando acción"
            android:textColor="#333333"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
